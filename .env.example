# Порт сервера
PORT=3000
NODE_ENV=production

# Публичный URL приложения (для placement.bind и OAuth)
APP_URL=https://your-app.vibecode.bitrix24.tech

# Checko API
CHECKO_API_KEY=your_checko_api_key

# VibeCode AI Router
VIBECODE_API_KEY=your_vibecode_api_key
VIBECODE_API_URL=https://vibecode.bitrix24.tech
VIBECODE_AI_MODEL=bitrix/google/gemma-4-26B-A4B-it

# Bitrix24 OAuth (ключ авторизации vibe_app_ из кабинета VibeCode)
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=

# Поля CRM для ИНН (пользовательские поля или стандартные)
BITRIX_INN_FIELD_DEAL=UF_CRM_INN
BITRIX_INN_FIELD_LEAD=UF_CRM_INN

# Поле для сохранения результата проверки (JSON)
BITRIX_RESULT_FIELD_DEAL=UF_CRM_CHECKO_RESULT
BITRIX_RESULT_FIELD_LEAD=UF_CRM_CHECKO_RESULT

# Кэш результатов (часы)
CACHE_TTL_HOURS=24
