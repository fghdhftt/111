# Порт сервера
PORT=3000
NODE_ENV=production

# Публичный URL приложения — заменить на URL Railway после деплоя
APP_URL=https://your-app.up.railway.app

# Checko API
CHECKO_API_KEY=your_checko_api_key

# Groq / OpenAI-совместимый API (бесплатно: https://console.groq.com)
OPENAI_API_KEY=gsk_your_groq_api_key
OPENAI_API_URL=https://api.groq.com/openai/v1/chat/completions
OPENAI_MODEL=llama-3.3-70b-versatile

# Bitrix24 OAuth (ключ авторизации из кабинета Bitrix24)
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=

# Поля CRM для ИНН (пользовательские поля или стандартные)
BITRIX_INN_FIELD_DEAL=UF_CRM_INN
BITRIX_INN_FIELD_LEAD=UF_CRM_INN

# Поле для сохранения результата проверки (JSON)
BITRIX_RESULT_FIELD_DEAL=UF_CRM_CHECKO_RESULT
BITRIX_RESULT_FIELD_LEAD=UF_CRM_CHECKO_RESULT

# Кэш результатов (часы)
CACHE_TTL_HOURS=24
